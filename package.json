{
  "name": "agentic-orchestrator-v2",
  "version": "2.0.0",
  "description": "SDK-based multi-agent orchestrator for OpenCode",
  "type": "module",
  "scripts": {
    "orchestrator": "tsx src/orchestrator.ts",
    "demo": "tsx src/orchestrator.ts --demo",
    "server": "opencode serve --port 4096",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test src/__tests__/**/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@opencode-ai/sdk": "^1.17.13",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
